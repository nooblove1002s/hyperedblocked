PORT=3000
# Keep this directory on persistent server storage so player IDs/names survive restarts.
HYPERBLOCK_DATA_DIR=./data
# Comma-separated origins. Include the exact deployed GitHub Pages origin.
CORS_ORIGINS=https://nooblove1002s.github.io,http://localhost:5173,http://localhost:8080
# Optional: set true only behind a trusted reverse proxy
TRUST_PROXY=false

# Required for POST /api/admin/servers to register official servers
ADMIN_API_KEY=replace-with-a-long-random-secret
